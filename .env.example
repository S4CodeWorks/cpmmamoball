# ==============================================================================
# CPM MAMOBALL — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Renomeie este arquivo para `.env.local` e preencha as variáveis correspondentes.
# ==============================================================================

# Supabase (Banco de Dados, Autenticação e Realtime)
# Obtenha estas credenciais em: Project Settings > API no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Web Push Notifications (VAPID)
# Gere um par de chaves executando: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@cpmmamoball.com
