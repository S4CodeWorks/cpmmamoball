# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (allow .env.example template)
.env*
!.env.example

# vercel
.vercel

# local tooling (dev server launch config, not app source)
.claude/

# supabase CLI local cache (may contain pooler connection strings)
supabase/.temp/

# typescript
*.tsbuildinfo

# automated tour / test recordings
videos/

# agent rules and local overrides
.claude/
CLAUDE.md
AGENTS.md
*.local
